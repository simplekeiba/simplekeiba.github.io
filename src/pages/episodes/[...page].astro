---
import Layout from '../../layouts/Layout.astro';
import { fetchEpisodes } from '../../lib/podcast';
import type { GetStaticPathsOptions } from 'astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const episodes = await fetchEpisodes();
  
  // 最新のものが上に来るように降順ソート
  const sortedEpisodes = episodes.sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime());
  
  // 1ページ20件でページネーション生成
  return paginate(sortedEpisodes, { pageSize: 20 });
}

const { page } = Astro.props;

// 枠番の背景・テキストカラークラスを返す (左側の細いバーとして表現)
const getWakuClasses = (num: number | null) => {
  const baseClasses = 'border-l-4 text-text bg-ink-raised group-hover:bg-ink transition-colors border-r border-ink-line';
  if (!num) return `${baseClasses} border-l-waku-1`;
  const waku = num % 8 === 0 ? 8 : num % 8;
  const classes = [
    '',
    'border-l-waku-1', // 1: 白
    'border-l-waku-2', // 2: 黒
    'border-l-waku-3', // 3: 赤
    'border-l-waku-4', // 4: 青
    'border-l-waku-5', // 5: 黄
    'border-l-waku-6', // 6: 緑
    'border-l-waku-7', // 7: 橙
    'border-l-waku-8', // 8: 桃
  ];
  return `${baseClasses} ${classes[waku]}`;
};

// YYYY.MM.DD 形式で日付をフォーマット
const formatDate = (date: Date) => {
  const yyyy = date.getFullYear();
  const mm = String(date.getMonth() + 1).padStart(2, '0');
  const dd = String(date.getDate()).padStart(2, '0');
  return `${yyyy}.${mm}.${dd}`;
};

// 尺を簡潔な表記にする
const formatDuration = (duration: string) => {
  if (!duration) return '--:--';
  const parts = duration.split(':');
  if (parts.length === 3) {
    const h = parseInt(parts[0], 10);
    const m = parts[1];
    const s = parts[2];
    if (h > 0) {
      return `${h}:${m}:${s}`;
    } else {
      return `${parseInt(m, 10)}:${s}`;
    }
  }
  return duration;
};

// タイトル末尾の「#219」のような話数表記を削除する
const cleanTitle = (title: string) => {
  if (!title) return '';
  return title.replace(/[#＃]\d+\s*$/, '').trim();
};
---

<Layout title="エピソード一覧 | シンプルKEIBA">
  <div class="max-w-4xl mx-auto px-4 py-12 w-full overflow-hidden">
    <header class="mb-10">
      <h1 class="font-display font-black text-3xl sm:text-4xl text-text mb-2">
        EPISODES
      </h1>
      <p class="text-text-muted font-body text-sm sm:text-base">
        全エピソード一覧
      </p>
    </header>

    <div class="bg-ink-raised border-y sm:border sm:rounded-lg border-ink-line w-full overflow-hidden">
      <!-- 出走表ヘッダー -->
      <div class="episode-header border-b-2 border-ink-line text-text-faint text-xs font-bold items-center hidden sm:grid">
        <div class="text-center">枠番</div>
        <div>タイトル</div>
        <div class="text-right pr-4">配信日 / 尺</div>
      </div>

      <!-- 出走表ボディ -->
      <ul class="flex flex-col w-full">
        {page.data.map((ep) => (
          <li class="episode-row border-b border-ink-line last:border-b-0 group bg-ink-raised hover:bg-ink transition-colors">
            {/* 1列目: 枠番チップ */}
            <div class={`episode-waku font-display font-bold text-lg sm:text-xl ${getWakuClasses(ep.episodeNumber)}`}>
              {ep.episodeNumber || '-'}
            </div>
            
            {/* 2列目: タイトル */}
            <div class="episode-title">
              <span class="font-body font-bold text-text text-sm sm:text-base leading-snug group-hover:text-gold-soft transition-colors truncate w-full">
                {cleanTitle(ep.title)}
              </span>
            </div>
              
            {/* 3列目: 日付と尺 */}
            <div class="episode-meta font-data tabular-nums border-l border-ink-line/50">
              <time datetime={ep.pubDate.toISOString()} class="text-text-muted text-xs sm:text-sm">
                {formatDate(ep.pubDate)}
              </time>
              <span class="text-text-faint text-[10px] sm:text-xs mt-0.5">
                {formatDuration(ep.duration)}
              </span>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <!-- ページネーション -->
    {page.lastPage > 1 && (
      <nav class="flex justify-center items-center gap-6 mt-12 font-data tabular-nums">
        {page.url.prev ? (
          <a href={page.url.prev} class="text-gold hover:text-gold-soft px-4 py-2 border border-gold rounded hover:bg-gold/10 transition-colors">
            &larr; Prev
          </a>
        ) : (
          <span class="text-text-muted opacity-50 px-4 py-2 border border-ink-line rounded cursor-not-allowed">
            &larr; Prev
          </span>
        )}
        
        <span class="text-text-muted text-sm sm:text-base">
          Page <strong class="text-text">{page.currentPage}</strong> of {page.lastPage}
        </span>
        
        {page.url.next ? (
          <a href={page.url.next} class="text-gold hover:text-gold-soft px-4 py-2 border border-gold rounded hover:bg-gold/10 transition-colors">
            Next &rarr;
          </a>
        ) : (
          <span class="text-text-muted opacity-50 px-4 py-2 border border-ink-line rounded cursor-not-allowed">
            Next &rarr;
          </span>
        )}
      </nav>
    )}
  </div>
</Layout>

<style>
  /* 
    タイトルが長い場合に親のGridコンテナを突き破るのを防ぐため、
    1fr の代わりに minmax(0, 1fr) を使用します。
  */
  .episode-header {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) 120px;
    align-items: center;
    gap: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    width: 100%;
  }

  .episode-row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) 120px;
    align-items: center;
    gap: 16px;
    height: 64px;
    width: 100%;
  }

  .episode-waku {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  .episode-title {
    display: flex;
    align-items: center;
    height: 100%;
    overflow: hidden;
  }

  .episode-meta {
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: right;
    padding-right: 16px;
    height: 100%;
  }

  @media (max-width: 639px) {
    /* モバイル幅でも確実に見切れないように、枠番とメタ領域を少し狭めます */
    .episode-row {
      grid-template-columns: 48px minmax(0, 1fr) 88px;
      gap: 8px;
    }
    .episode-meta {
      padding-right: 8px;
    }
  }
</style>
