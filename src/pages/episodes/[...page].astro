---
import Layout from '../../layouts/Layout.astro';
import { fetchEpisodes } from '../../lib/podcast';
import { formatDateJa } from '../../lib/date';
import { cleanEpisodeTitle, formatEpisodeDuration } from '../../lib/episodeDisplay';
import type { GetStaticPathsOptions } from 'astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const episodes = await fetchEpisodes();

  // 最新のものが上に来るように降順ソート
  const sortedEpisodes = episodes.sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime());

  // 1ページ20件でページネーション生成
  return paginate(sortedEpisodes, { pageSize: 20 });
}

const { page } = Astro.props;

// メタ情報 (話数・配信日・尺) を「・」区切りの1行にまとめる。話数がない回はそのまま省く
const buildMeta = (ep: { episodeNumber: number | null; pubDate: Date; duration: string }) => {
  const parts = [
    ep.episodeNumber ? `#${ep.episodeNumber}` : '',
    formatDateJa(ep.pubDate),
    formatEpisodeDuration(ep.duration),
  ].filter(Boolean);
  return parts.join('　');
};
---

<Layout title="エピソード一覧 | シンプルKEIBA">
  <div class="max-w-[900px] mx-auto px-4 py-12 w-full overflow-hidden">
    <header class="mb-8">
      <h1 class="font-display font-black text-3xl sm:text-4xl text-text mb-2">
        EPISODES
      </h1>
      <p class="text-text-muted font-body text-sm sm:text-base">
        全エピソード一覧
      </p>
    </header>

    <!-- エピソード検索 -->
    <div class="mb-10">
      <label for="episode-search" class="sr-only">エピソードを検索</label>
      <input
        type="search"
        id="episode-search"
        placeholder="エピソードを検索"
        class="w-full bg-ink-raised border border-ink-line rounded-md px-4 py-3 text-sm text-text placeholder:text-text-faint focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold transition-colors"
      />
      <p id="search-status" class="mt-2 text-xs text-text-faint" aria-live="polite"></p>
    </div>

    <!-- エピソード一覧 (アーカイブ表示) -->
    <ul id="episode-list" class="w-full">
      {page.data.map((ep) => (
        <li class="border-b border-white/10 last:border-b-0">
          <a
            href={`/episodes/${ep.slug}/`}
            class="flex items-center gap-4 py-5 md:py-7 group focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-gold outline-none"
          >
            <div class="min-w-0 flex-1">
              <div class="font-data tabular-nums text-text-muted text-[12px] md:text-[13px] font-medium mb-1.5">
                {buildMeta(ep)}
              </div>
              <div class="font-body font-semibold text-text text-base md:text-lg leading-[1.55] group-hover:text-gold-soft transition-colors">
                {cleanEpisodeTitle(ep.title)}
              </div>
            </div>
            <span class="text-text-faint text-sm shrink-0 group-hover:text-gold transition-colors" aria-hidden="true">
              &rarr;
            </span>
          </a>
        </li>
      ))}
    </ul>

    <!-- 検索結果 (JSで動的に描画) -->
    <ul id="search-results" class="w-full" hidden></ul>

    <!-- ページネーション -->
    {page.lastPage > 1 && (
      <nav id="pagination-nav" class="flex justify-center items-center gap-6 mt-12 font-data tabular-nums">
        {page.url.prev ? (
          <a href={page.url.prev} class="text-gold hover:text-gold-soft px-4 py-2 border border-gold rounded hover:bg-gold/10 transition-colors">
            &larr; Prev
          </a>
        ) : (
          <span class="text-text-muted opacity-50 px-4 py-2 border border-ink-line rounded cursor-not-allowed">
            &larr; Prev
          </span>
        )}

        <span class="text-text-muted text-sm md:text-base">
          Page <strong class="text-text">{page.currentPage}</strong> of {page.lastPage}
        </span>

        {page.url.next ? (
          <a href={page.url.next} class="text-gold hover:text-gold-soft px-4 py-2 border border-gold rounded hover:bg-gold/10 transition-colors">
            Next &rarr;
          </a>
        ) : (
          <span class="text-text-muted opacity-50 px-4 py-2 border border-ink-line rounded cursor-not-allowed">
            Next &rarr;
          </span>
        )}
      </nav>
    )}
  </div>
</Layout>

<script>
  import { formatDateJa } from '../../lib/date';
  import { cleanEpisodeTitle, formatEpisodeDuration } from '../../lib/episodeDisplay';

  interface SearchEpisode {
    slug: string;
    episodeNumber: number | null;
    title: string;
    pubDate: string;
    duration: string;
    description: string;
  }

  const input = document.getElementById('episode-search') as HTMLInputElement | null;
  const listEl = document.getElementById('episode-list');
  const paginationEl = document.getElementById('pagination-nav');
  const resultsEl = document.getElementById('search-results');
  const statusEl = document.getElementById('search-status');

  let allEpisodes: SearchEpisode[] | null = null;
  let loadingPromise: Promise<void> | null = null;

  function loadIndex(): Promise<void> {
    if (!loadingPromise) {
      loadingPromise = fetch('/episodes/search-index.json')
        .then((res) => res.json())
        .then((data: SearchEpisode[]) => {
          allEpisodes = data;
        })
        .catch(() => {
          allEpisodes = [];
          if (statusEl) statusEl.textContent = '検索データの取得に失敗しました。';
        });
    }
    return loadingPromise;
  }

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function buildMeta(ep: SearchEpisode): string {
    const parts = [
      ep.episodeNumber ? `#${ep.episodeNumber}` : '',
      formatDateJa(ep.pubDate),
      formatEpisodeDuration(ep.duration),
    ].filter(Boolean);
    return parts.join('　');
  }

  function renderResults(query: string) {
    const q = query.trim();

    if (!q) {
      if (listEl) listEl.hidden = false;
      if (paginationEl) paginationEl.hidden = false;
      if (resultsEl) {
        resultsEl.hidden = true;
        resultsEl.innerHTML = '';
      }
      if (statusEl) statusEl.textContent = '';
      return;
    }

    if (listEl) listEl.hidden = true;
    if (paginationEl) paginationEl.hidden = true;
    if (!resultsEl) return;
    resultsEl.hidden = false;

    const lower = q.toLowerCase();
    const matches = (allEpisodes || []).filter((ep) => {
      return ep.title.toLowerCase().includes(lower) || ep.description.toLowerCase().includes(lower);
    });

    if (statusEl) statusEl.textContent = `${matches.length}件のエピソードが見つかりました`;

    if (matches.length === 0) {
      resultsEl.innerHTML = '<li class="py-12 text-center text-text-muted text-sm">該当するエピソードが見つかりませんでした</li>';
      return;
    }

    resultsEl.innerHTML = matches
      .map((ep) => {
        const title = escapeHtml(cleanEpisodeTitle(ep.title));
        const meta = escapeHtml(buildMeta(ep));
        return `
          <li class="border-b border-white/10 last:border-b-0">
            <a href="/episodes/${ep.slug}/" class="flex items-center gap-4 py-5 md:py-7 group focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-gold outline-none">
              <div class="min-w-0 flex-1">
                <div class="font-data tabular-nums text-text-muted text-[12px] md:text-[13px] font-medium mb-1.5">${meta}</div>
                <div class="font-body font-semibold text-text text-base md:text-lg leading-[1.55] group-hover:text-gold-soft transition-colors">${title}</div>
              </div>
              <span class="text-text-faint text-sm shrink-0 group-hover:text-gold transition-colors" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        `;
      })
      .join('');
  }

  let debounceTimer: ReturnType<typeof setTimeout>;
  input?.addEventListener('input', (e) => {
    const value = (e.target as HTMLInputElement).value;
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      if (!allEpisodes) {
        loadIndex().then(() => renderResults(value));
      } else {
        renderResults(value);
      }
    }, 150);
  });
</script>
