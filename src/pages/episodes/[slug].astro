---
import Layout from '../../layouts/Layout.astro';
import { fetchEpisodes } from '../../lib/podcast';
import { formatDateJa } from '../../lib/date';
import { getEntry } from 'astro:content';
import { PLATFORM_LINKS } from '../../data/links';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const episodes = await fetchEpisodes();

  const appleDataPath = path.resolve('./src/data/apple_episodes.json');
  let appleMap = new Map<number, string>();
  try {
    const appleData = JSON.parse(fs.readFileSync(appleDataPath, 'utf-8'));
    const appleEps = appleData.results.filter((r: any) => r.wrapperType === 'podcastEpisode');
    for (const ae of appleEps) {
      const title = ae.trackName || '';
      const regex = /[#＃](\d+)/g;
      let match;
      let num = null;
      while ((match = regex.exec(title)) !== null) {
        num = parseInt(match[1], 10);
      }
      if (num !== null) {
        appleMap.set(num, ae.trackId.toString());
      }
    }
  } catch (err) {
    console.error('Failed to load apple_episodes.json', err);
  }

  return episodes.map((ep) => ({
    params: { slug: ep.slug },
    props: { ep, appleTrackId: ep.episodeNumber !== null ? appleMap.get(ep.episodeNumber) : undefined },
  }));
}

const { ep, appleTrackId } = Astro.props;
const slug = ep.slug;

// Content Collections からショーノートMarkdownを取得
const shownoteEntry = await getEntry('shownotes', slug);
const { Content } = shownoteEntry ? await shownoteEntry.render() : { Content: null };

// htmlタグを除去してテキストのみ抽出
const stripHtml = (html: string) => {
  return html.replace(/<[^>]*>?/gm, '').trim();
};

const cleanDesc = stripHtml(ep.description);
// meta description は120文字以内
const metaDesc = cleanDesc.length > 120 ? cleanDesc.slice(0, 117) + '...' : cleanDesc;

// title は32文字以内
const titleLimit = 22; // " | シンプルKEIBA" (9文字)を考慮して約22文字
const shortTitle = ep.title.length > titleLimit ? ep.title.slice(0, titleLimit - 1) + '…' : ep.title;
const metaTitle = `${shortTitle} | シンプルKEIBA`;

const formatDuration = (duration: string) => {
  if (!duration) return '--:--';
  const parts = duration.split(':');
  if (parts.length === 3) {
    const h = parseInt(parts[0], 10);
    const m = parts[1];
    const s = parts[2];
    if (h > 0) return `${h}:${m}:${s}`;
    else return `${parseInt(m, 10)}:${s}`;
  }
  return duration;
};

// 構造化データ
const jsonLd = {
  "@context": "https://schema.org/",
  "@type": "PodcastEpisode",
  "name": ep.title,
  "datePublished": ep.pubDate.toISOString(),
  "description": metaDesc,
  "url": `https://simplekeiba.github.io/episodes/${slug}/`,
  "timeRequired": `PT${ep.duration.replace(':', 'M')}S`
};

const shareText = encodeURIComponent(metaTitle);
const shareUrl = encodeURIComponent(jsonLd.url);
const xShareUrl = `https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`;
const lineShareUrl = `https://social-plugins.line.me/lineit/share?url=${shareUrl}`;

const appleUrl = appleTrackId 
  ? `https://podcasts.apple.com/jp/podcast/id1734404201?i=${appleTrackId}` 
  : PLATFORM_LINKS.apple;

const getWakuClasses = (num: number | null) => {
  const baseClasses = 'border-l-4 text-text bg-ink-raised border-r border-ink-line';
  if (!num) return `${baseClasses} border-l-waku-1`;
  const waku = num % 8 === 0 ? 8 : num % 8;
  const classes = ['', 'border-l-waku-1', 'border-l-waku-2', 'border-l-waku-3', 'border-l-waku-4', 'border-l-waku-5', 'border-l-waku-6', 'border-l-waku-7', 'border-l-waku-8'];
  return `${baseClasses} ${classes[waku]}`;
};
---

<Layout title={metaTitle} description={metaDesc} ogImage={`https://simplekeiba.com/og/${slug}.png`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="max-w-3xl mx-auto px-4 py-10 md:py-16 w-full">
    {/* エピソードヘッダー */}
    <header class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <div class={`font-display font-bold text-xl flex items-center justify-center w-12 h-12 ${getWakuClasses(ep.episodeNumber)}`}>
          {ep.episodeNumber || '-'}
        </div>
        <div class="font-data tabular-nums text-text-muted text-sm flex gap-3">
          <time datetime={ep.pubDate.toISOString()}>{formatDateJa(ep.pubDate)}</time>
          <span class="text-text-faint">&middot;</span>
          <span>{formatDuration(ep.duration)}</span>
        </div>
      </div>
      <h1 class="font-body font-black text-2xl md:text-3xl text-text leading-snug mb-8">
        {ep.title}
      </h1>

      {/* Spotify / Apple で聴くボタン */}
      <div class="flex flex-col sm:flex-row gap-4 mb-8">
        <a href={PLATFORM_LINKS.spotify} target="_blank" rel="noopener noreferrer" data-cta-location="episode-top" class="flex-1 flex items-center justify-center gap-2 bg-[#1DB954] hover:bg-[#1ed760] text-ink font-bold py-3 px-6 rounded-full transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1DB954]">
          Spotifyで聴く
        </a>
        <a href={appleUrl} target="_blank" rel="noopener noreferrer" data-cta-location="episode-top" class="flex-1 flex items-center justify-center gap-2 bg-[#FA243C] hover:bg-[#ff3b51] text-ink font-bold py-3 px-6 rounded-full transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FA243C]">
          Apple Podcastsで聴く
        </a>
      </div>
    </header>

    {/* ショーノート領域 */}
    <article class="bg-read-bg text-read-text p-6 md:p-10 rounded-xl mb-12 shadow-sm border border-ink-line">
      <div class="shownote-content">
        {Content ? (
          <Content />
        ) : (
          <div set:html={ep.description} />
        )}
      </div>
    </article>

    {/* Spotify / Apple で聴くボタン (ショーノート直下) */}
    <div class="flex flex-col sm:flex-row gap-4 mb-12">
      <a href={PLATFORM_LINKS.spotify} target="_blank" rel="noopener noreferrer" data-cta-location="episode-bottom" class="flex-1 flex items-center justify-center gap-2 bg-[#1DB954] hover:bg-[#1ed760] text-ink font-bold py-3 px-6 rounded-full transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1DB954]">
        Spotifyで聴く
      </a>
      <a href={appleUrl} target="_blank" rel="noopener noreferrer" data-cta-location="episode-bottom" class="flex-1 flex items-center justify-center gap-2 bg-[#FA243C] hover:bg-[#ff3b51] text-ink font-bold py-3 px-6 rounded-full transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FA243C]">
        Apple Podcastsで聴く
      </a>
    </div>

    {/* フッター領域 */}
    <footer class="border-t border-ink-line pt-10">
      {/* 共有ボタン */}
      <div class="flex flex-col sm:flex-row justify-center gap-4 mb-12">
        <a href={xShareUrl} target="_blank" rel="noopener noreferrer" class="flex justify-center items-center gap-2 text-sm font-bold text-text hover:text-gold transition-colors px-6 py-3 border border-ink-line rounded hover:border-gold">
          X (Twitter) でシェア
        </a>
        <a href={lineShareUrl} target="_blank" rel="noopener noreferrer" class="flex justify-center items-center gap-2 text-sm font-bold text-text hover:text-gold transition-colors px-6 py-3 border border-ink-line rounded hover:border-gold">
          LINE で送る
        </a>
      </div>

      {/* CTA */}
      <div class="text-center">
        <a href="/episodes/" class="inline-block bg-gold text-ink font-bold py-4 px-10 rounded-full hover:bg-gold-soft transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold">
          他の回も聴く
        </a>
      </div>
    </footer>
  </div>
</Layout>

<style is:global>
  .shownote-content {
    /* 行長40〜45文字: 日本語は概ね 40em */
    max-width: 45em;
    margin: 0 auto;
    font-size: 1rem;
    line-height: 1.9;
  }
  
  .shownote-content p {
    margin-bottom: 1.8em;
  }
  
  .shownote-content p:last-child {
    margin-bottom: 0;
  }
  
  .shownote-content a {
    color: var(--color-read-text);
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 700;
    transition: color 0.2s, opacity 0.2s;
  }
  .shownote-content a:hover {
    opacity: 0.8;
  }
  
  .shownote-content ul, .shownote-content ol {
    margin-bottom: 1.8em;
    padding-left: 1.5em;
  }
  .shownote-content li {
    margin-bottom: 0.5em;
  }
  
  /* description の改行タグへの対応 */
  .shownote-content br {
    display: block;
    content: "";
    margin-top: 0.5em;
  }
</style>
