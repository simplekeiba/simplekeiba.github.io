---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import HighlightCarousel, { type CarouselSlide } from '../components/HighlightCarousel.astro';
import specialEventBanner from '../assets/special-event-banner.png';
import carouselMembership from '../assets/carousel-membership.png';
import carouselYoutube from '../assets/carousel-youtube.png';
import carouselYosouou from '../assets/carousel-yosouou.png';
import carouselSensePaddock from '../assets/carousel-sense-paddock.png';
import { fetchEpisodes } from '../lib/podcast';
import { formatDateJa, formatDateTimeJa } from '../lib/date';
import { fetchYosououData, getNextRace, isYosououCampaignActive } from '../lib/yosouou';
import { PLATFORM_LINKS, YOUTUBE_URL, MEMBERSHIP_URL, MESSAGE_FORM_URL } from '../data/links';
import { RECOMMENDED_EPISODES } from '../data/recommendedEpisodes';

const episodes = await fetchEpisodes();
const latestEpisode = episodes.length > 0 ? episodes[episodes.length - 1] : null;

const recommendedEpisodes = RECOMMENDED_EPISODES.map((rec) => {
  const ep = episodes.find((e) => e.slug === rec.slug);
  return ep ? { ...ep, spotifyUrl: rec.spotifyUrl } : null;
}).filter((ep): ep is NonNullable<typeof ep> => Boolean(ep));

const spotifyShowId = PLATFORM_LINKS.spotify.match(/show\/([a-zA-Z0-9]+)/)?.[1] ?? '';

const campaignActive = isYosououCampaignActive();
const nextRace = campaignActive ? getNextRace() : null;
const yosououData = campaignActive ? await fetchYosououData() : null;

const carouselSlides: CarouselSlide[] = [
  {
    id: 'trailer',
    image: '/assets/video/simplekeibamv.png',
    alt: 'OFFICIAL TRAILER',
    variant: 'trailer',
    ctaLocation: 'carousel-trailer',
  },
  {
    id: 'yosouou',
    image: carouselYosouou,
    alt: '秋のGⅠ予想王決定戦',
    href: '/yosouou/',
    ctaLocation: 'carousel-yosouou',
  },
  {
    id: 'youtube',
    image: carouselYoutube,
    alt: 'YouTube',
    href: YOUTUBE_URL,
    external: true,
    ctaLocation: 'carousel-youtube',
  },
  {
    id: 'sense-paddock',
    image: carouselSensePaddock,
    alt: 'SENSE PADDOCK',
    href: 'https://www.sense-paddock.com/',
    external: true,
    ctaLocation: 'carousel-sense-paddock',
  },
  {
    id: 'membership',
    image: carouselMembership,
    alt: 'メンバーシップ',
    href: MEMBERSHIP_URL,
    external: true,
    ctaLocation: 'carousel-membership',
  },
];

const sectionLabelClass = 'text-xs md:text-sm font-bold text-gold tracking-widest uppercase mb-3';
const sectionHeadingClass = 'text-[28px] md:text-4xl font-display font-bold text-text leading-tight';
const ctaButtonClass =
  'inline-flex items-center justify-center gap-2 bg-gold hover:bg-gold-soft text-ink font-bold px-8 py-4 rounded-md tracking-wide transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold';

const formatDuration = (duration: string) => {
  if (!duration) return '--:--';
  const parts = duration.split(':');
  if (parts.length === 3) {
    const h = parseInt(parts[0], 10);
    const m = parts[1];
    const s = parts[2];
    return h > 0 ? `${h}:${m}:${s}` : `${parseInt(m, 10)}:${s}`;
  }
  return duration;
};
---

<Layout
  title="シンプルKEIBA～難しくない競馬ラジオ～"
  description="競馬を、シンプルかつ分かりやすく。競馬予想、名馬、競馬史、馬事文化まで、それぞれの視点から競馬の面白さを届けるポッドキャスト番組です。"
  ogImage="https://simplekeiba.com/assets/og-top-20260815.png"
  ogImageAlt="Simple KEIBA～難しくない競馬ラジオ～"
>
  <!-- ヒーロー＝ハイライトカルーセル：メンバーシップ・YouTube・秋のGⅠ予想王決定戦への導線 -->
  <HighlightCarousel slides={carouselSlides} />

  <div class="max-w-3xl mx-auto px-4 space-y-16 py-16">
    <!-- 秋のGⅠ予想王決定戦（企画期間中のみ表示） -->
    {campaignActive && (
      <section>
        <a
          href="/yosouou/"
          class="block bg-ink-raised border border-gold/40 hover:border-gold rounded-2xl p-6 md:p-8 transition-colors"
        >
          <p class="text-xs md:text-sm font-bold text-gold tracking-widest mb-3">秋のGⅠ予想王決定戦</p>
          {nextRace ? (
            <>
              <p class="font-display text-xl md:text-2xl font-bold text-text mb-1">{nextRace.name}</p>
              <p class="font-data text-text-muted mb-6">締切 {formatDateTimeJa(nextRace.deadline)}</p>
            </>
          ) : (
            <p class="font-display text-xl md:text-2xl font-bold text-text mb-6">全12レースが終了しました</p>
          )}
          <div class="flex items-center justify-between">
            <span class="text-sm text-text-muted">
              現在の参加人数 <strong class="text-text font-data">{yosououData?.participants.length ?? 0}人</strong>
            </span>
            <span class="text-gold font-bold text-sm">詳しく見る&nbsp;→</span>
          </div>
        </a>
      </section>
    )}

    <!-- 最新エピソード -->
    <section>
      <h2 class="font-display text-2xl font-bold text-text mb-6">最新エピソード</h2>
      {latestEpisode ? (
        <div class="bg-ink-raised border border-ink-line rounded-2xl p-6 md:p-8">
          <div class="font-data tabular-nums text-text-muted text-sm mb-3">
            {latestEpisode.episodeNumber && <span>第{latestEpisode.episodeNumber}回&nbsp;&middot;&nbsp;</span>}
            <time datetime={latestEpisode.pubDate.toISOString()}>{formatDateJa(latestEpisode.pubDate)}</time>
            <span>&nbsp;&middot;&nbsp;{formatDuration(latestEpisode.duration)}</span>
          </div>
          <h3 class="font-body font-black text-xl text-text mb-6 leading-snug">{latestEpisode.title}</h3>
          <iframe
            style="border-radius:12px"
            src={`https://open.spotify.com/embed/show/${spotifyShowId}?utm_source=generator&theme=0`}
            width="100%"
            height="152"
            frameborder="0"
            allowfullscreen
            loading="lazy"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            title="シンプルKEIBA を Spotify で再生"
          />
        </div>
      ) : (
        <p class="text-text-muted">エピソードを取得できませんでした。</p>
      )}
    </section>

    <!-- 01｜SPECIAL EVENT -->
    <section>
      <p class={sectionLabelClass}>SPECIAL EVENT</p>
      <Image
        src={specialEventBanner}
        alt="2026年下半期 G1予想最強リスナー決定戦。秋のGⅠ12戦。毎回、勝つと思う馬を1頭選ぶだけ。"
        width={1755}
        height={594}
        class="w-full h-auto rounded-lg mb-5"
      />
      <a href="/yosouou/" class="inline-flex items-center gap-1 text-[15px] md:text-base font-semibold text-gold hover:text-gold-soft transition-colors">
        企画に参加する<span aria-hidden="true">→</span>
      </a>
    </section>

  </div>

  <!-- 02｜FIRST LISTEN（他セクションより広い最大幅を持つ独立バンド） -->
  <section class="pt-20 pb-16 md:pt-24 md:pb-20">
    <div class="max-w-[1080px] mx-auto px-4">
      <p class={sectionLabelClass}>FIRST LISTEN</p>
      <h2 class={`${sectionHeadingClass} mb-10 md:mb-12`}>初めての方におすすめ</h2>
      {recommendedEpisodes.length > 0 ? (
        <div class="flex flex-col">
          {recommendedEpisodes.map((ep, i) => (
            <a
              href={ep.spotifyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex flex-col md:flex-row md:items-center gap-3 md:gap-8 py-8 border-b border-white/10 last:border-b-0 group"
            >
              <p class="font-data text-xs md:text-sm font-semibold text-gold tracking-widest md:w-[60px] md:shrink-0">
                {String(i + 1).padStart(2, '0')}
              </p>
              <div class="min-w-0 md:flex-1">
                <p class="text-[17px] md:text-[21px] font-bold text-text leading-[1.5] mb-2 line-clamp-4 md:line-clamp-3 group-hover:text-gold-soft transition-colors">
                  {ep.title}
                </p>
                <p class="font-data tabular-nums text-[11px] md:text-xs text-text-muted">
                  {formatDateJa(ep.pubDate)}　{formatDuration(ep.duration)}
                </p>
              </div>
              <span class="text-sm font-semibold text-gold group-hover:text-gold-soft transition-colors md:w-[170px] md:shrink-0 md:text-right">
                エピソードを聴く<span aria-hidden="true">→</span>
              </span>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-sm text-text-faint">{'{{TODO: おすすめエピソード3本の選定}}'}</p>
      )}
    </div>
  </section>

  <!-- MESSAGE：ページを締める静かなCTA -->
  <section class="border-t border-ink-line bg-ink-raised">
    <div class="max-w-[1140px] mx-auto px-4 py-16 md:py-20 grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-12 items-start">
      <div>
        <p class="text-xs font-data font-bold text-gold tracking-widest uppercase mb-4">MESSAGE</p>
        <h2 class="text-[28px] md:text-4xl font-display font-bold text-text leading-tight">
          あなたの声を、<br />
          番組へ。
        </h2>
      </div>
      <div>
        <p class="text-[15px] text-white/70 leading-[1.8] mb-6">
          感想・質問・テーマのリクエストなど、<br />
          お便りをお待ちしています。
        </p>
        <a
          href={MESSAGE_FORM_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-[15px] md:text-base font-semibold text-gold hover:text-gold-soft transition-colors"
        >
          お便りを送る<span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
