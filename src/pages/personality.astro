---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import mizoguchiPhoto from '../assets/personality-mizoguchi.jpg';
import owadaPhoto from '../assets/personality-owada.png';
import higashibataPhoto from '../assets/personality-higashibata.jpg';

const personalities = [
  {
    name: '溝口 勇樹',
    photo: mizoguchiPhoto,
    bioLines: [
      '競馬大好き経営者。',
      '馬券は直感で選ぶ永遠の競馬初心者。',
      '好きな騎手：川田将雅騎手',
      '好きな馬：ダノンプレミアム',
    ],
    sns: { platform: 'x' as const, url: 'https://x.com/UMAmizo' },
  },
  {
    name: '大和田 咲綺',
    photo: owadaPhoto,
    bioLines: [
      'SENSEPADDOCK主宰。',
      '競馬歴20年以上のフィギュアクリエイター。',
      '馬券は3連単。',
      '好きな騎手：武豊騎手',
      '好きな馬：テンポイント',
    ],
    sns: { platform: 'instagram' as const, url: 'https://www.instagram.com/sense_paddock?igsh=aTl6a281NG11b2Fs' },
  },
  {
    name: '東端 佑典',
    photo: higashibataPhoto,
    bioLines: [
      'シンプルKEIBA主宰。',
      '年間1000時間競馬に費やすビジネスマン。',
      '論理的に考えるのが好き。',
      '好きな騎手：坂井瑠星騎手',
      '好きな馬：フィエールマン、フォーエバーヤング',
    ],
    sns: { platform: 'x' as const, url: 'https://x.com/ytBusiness1' },
  },
];
---

<Layout title="パーソナリティ紹介 - シンプルKEIBA" description="シンプルKEIBA～難しくない競馬ラジオ～のパーソナリティ3名を紹介します。">
  <div class="max-w-3xl mx-auto px-4 py-12 md:py-16">
    <h1 class="text-3xl md:text-4xl font-display font-bold text-text mb-4">パーソナリティ紹介</h1>
    <p class="text-base md:text-lg text-text-muted leading-relaxed mb-12">
      「シンプルKEIBA～難しくない競馬ラジオ～」をお届けする3人です。
    </p>

    <div class="divide-y divide-ink-line">
      {personalities.map((person) => (
        <section class="py-12 first:pt-0 last:pb-0 flex flex-col sm:flex-row gap-6 sm:gap-8 items-center sm:items-start">
          <div class="shrink-0 w-32 h-32 md:w-40 md:h-40 rounded-full overflow-hidden border-2 border-gold">
            <Image
              src={person.photo}
              alt={`${person.name}の写真`}
              width={320}
              height={320}
              fit="cover"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="flex-1 text-center sm:text-left">
            <h2 class="text-xl md:text-2xl font-display font-bold text-text mb-3">{person.name}</h2>
            <p class="text-base md:text-lg text-text-muted leading-relaxed mb-4">
              {person.bioLines.map((line, i) => (
                <>
                  {line}
                  {i < person.bioLines.length - 1 && <br />}
                </>
              ))}
            </p>
            <a
              href={person.sns.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${person.name}の${person.sns.platform === 'x' ? 'X' : 'Instagram'}`}
              class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-ink-line text-text-muted hover:text-gold hover:border-gold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
            >
              {person.sns.platform === 'x' ? (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                </svg>
              ) : (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                  <line x1="17.5" y1="6.5" x2="17.5" y2="6.5" />
                </svg>
              )}
            </a>
          </div>
        </section>
      ))}
    </div>
  </div>
</Layout>
