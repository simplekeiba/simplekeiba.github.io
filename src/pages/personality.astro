---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import owadaPhoto from '../assets/personality-owada.png';
import higashibataPhoto from '../assets/personality-higashibata.jpg';

interface Member {
  name: string;
  photo: ImageMetadata;
  keywordEn: string;
  keywordJa: string;
  descriptionLines: string[];
  favoriteJockey: string;
  favoriteHorse: string;
  sns: { platform: 'x' | 'instagram'; url: string };
}

// 新しいメンバーを追加する場合は、この配列に1件足すだけでよい。
// 同じ「写真左＋テキスト右」の行として縦に追加される
// （MORE VOICES はこの一覧の外にある独立セクション）。
const members: Member[] = [
  {
    name: '東端 佑典',
    photo: higashibataPhoto,
    keywordEn: 'LOGIC',
    keywordJa: '論理的思考',
    descriptionLines: ['シンプルKEIBA主宰。', '年間1000時間競馬に費やすビジネスマン。'],
    favoriteJockey: '坂井瑠星騎手',
    favoriteHorse: 'フィエールマン',
    sns: { platform: 'x', url: 'https://x.com/ytBusiness1' },
  },
  {
    name: '大和田 咲綺',
    photo: owadaPhoto,
    keywordEn: 'HORSE & CULTURE',
    keywordJa: '馬と文化',
    descriptionLines: ['フィギュア工房「SENSEPADDOCK」主宰。', '競馬歴20年以上のクリエイター。'],
    favoriteJockey: '武豊騎手',
    favoriteHorse: 'テンポイント',
    sns: { platform: 'instagram', url: 'https://www.instagram.com/sense_paddock?igsh=aTl6a281NG11b2Fs' },
  },
];
---

<Layout title="パーソナリティ紹介 - シンプルKEIBA" description="シンプルKEIBA～難しくない競馬ラジオ～を届けるメンバーを紹介します。">
  <div class="max-w-[700px] mx-auto px-4 py-12 md:py-16">
    <p class="text-xs font-data font-bold text-gold tracking-widest uppercase mb-3">PERSONALITIES</p>
    <h1 class="text-[28px] md:text-4xl font-display font-bold text-text leading-tight mb-12 md:mb-14">
      それぞれの視点で、競馬を語る。
    </h1>
    <p class="text-xs font-data font-bold text-gold tracking-widest uppercase mb-6 md:mb-8">CURRENT MEMBERS</p>

    <div class="divide-y divide-ink-line">
      {members.map((member) => (
        <div class="flex flex-row items-start gap-4 md:gap-6 py-8 first:pt-0 last:pb-0">
          <div class="shrink-0 w-24 h-24 md:w-32 md:h-32 rounded-full overflow-hidden border border-ink-line">
            <Image
              src={member.photo}
              alt={`${member.name}の写真`}
              width={320}
              height={320}
              fit="cover"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="min-w-0 flex-1">
            <h2 class="text-lg md:text-xl font-display font-bold text-text mb-1">{member.name}</h2>
            <p class="text-xs mb-3">
              <span class="font-data font-bold text-gold tracking-wide uppercase">{member.keywordEn}</span>
              <span class="text-gold-soft"> / {member.keywordJa}</span>
            </p>
            <p class="text-sm text-text-muted leading-[1.7] mb-3">
              {member.descriptionLines.map((line, i) => (
                <>
                  {line}
                  {i < member.descriptionLines.length - 1 && <br />}
                </>
              ))}
            </p>
            <dl class="text-xs space-y-1 mb-3">
              <div class="flex gap-1.5">
                <dt class="font-data text-text-faint shrink-0">FAVORITE JOCKEY</dt>
                <dd class="text-text-muted">{member.favoriteJockey}</dd>
              </div>
              <div class="flex gap-1.5">
                <dt class="font-data text-text-faint shrink-0">FAVORITE HORSE</dt>
                <dd class="text-text-muted">{member.favoriteHorse}</dd>
              </div>
            </dl>
            <a
              href={member.sns.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${member.name}の${member.sns.platform === 'x' ? 'X' : 'Instagram'}`}
              class="inline-flex items-center justify-center w-6 h-6 rounded-full text-text-muted hover:text-gold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
            >
              {member.sns.platform === 'x' ? (
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                </svg>
              ) : (
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                  <line x1="17.5" y1="6.5" x2="17.5" y2="6.5" />
                </svg>
              )}
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- MORE VOICES：人物一覧とは別の、独立したブランドメッセージ。空席には見せない。 -->
    <div class="mt-4 pt-8 border-t border-ink-line">
      <p class="text-xs font-data font-bold text-gold tracking-widest uppercase mb-2">
        <span aria-hidden="true">＋</span> MORE VOICES
      </p>
      <p class="text-sm text-text-muted mb-1">新しい視点も、これから。</p>
      <p class="text-sm text-text-muted mb-4">
        競馬の知識ではなく、あなたにしかない「競馬の見方」を探しています。
      </p>
      <a
        href="/personality/recruit"
        class="inline-flex items-center gap-1 text-sm text-gold hover:text-gold-soft transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold rounded-sm"
      >
        新メンバー募集について<span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</Layout>
