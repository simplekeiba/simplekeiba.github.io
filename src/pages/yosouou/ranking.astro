---
import Layout from '../../layouts/Layout.astro';
import {
  fetchYosououData,
  isBeforeFirstAggregation,
  getFirstAggregationDate,
} from '../../lib/yosouou';
import { formatRaceDateJa } from '../../lib/date';
import { PLATFORM_LINKS } from '../../data/links';

const data = await fetchYosououData();
const totalParticipants = data.participants.length;

// 集計開始前は「最終更新」を出さない。運営がセルを最後に触った日が
// 出るだけで、参加者には意味が無いため（src/lib/yosouou.ts を参照）
const beforeFirst = isBeforeFirstAggregation(data);

// 締切に間に合った応募がまだ無い参加者がいるか（表の「-」の凡例を出すかどうか）
const hasPending = data.participants.some((p) => p.totalPoints === null);
const firstAggregationDate = getFirstAggregationDate();

const formUrl = "https://forms.gle/1r71nxcxBe35zEVE7";
---

<Layout
  title="現在のランキング - 2026年下半期 G1予想最強リスナー決定戦 | シンプルKEIBA"
  description="2026年下半期 G1予想最強リスナー決定戦の現在の全ランキング状況です。"
>
  <div class="max-w-3xl mx-auto px-4 py-8 md:py-12 space-y-12">
    
    <div class="mb-6">
      <a href="/yosouou/" class="text-gold hover:text-gold-soft transition-colors font-bold inline-flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
        </svg>
        企画トップへ戻る
      </a>
    </div>

    {data.fetchFailed && (
      <div class="bg-red-900/50 border border-red-500 text-red-100 p-4 rounded text-center">
        <p>データ取得に失敗しています。現在表示されている情報は最新ではない可能性があります。</p>
      </div>
    )}

    <section>
      <h1 class="font-display text-3xl md:text-4xl font-bold mb-8 text-white">現在のランキング</h1>

      {/*
        ルール追加の告知。ルールページと同じ体裁・同じ日付で出す（docs/spec.md §4.8.3）。
        同じポイントなのに順位が違う理由をここで示さないと、集計ミスに見えてしまう。
      */}
      <div class="mb-8 border-l-4 border-alert bg-alert/10 rounded-r-md px-5 py-4">
        <p class="font-data text-xs md:text-sm font-bold text-alert tracking-widest mb-2">
          2026.10.20　ルール追加
        </p>
        <p class="text-sm md:text-base text-text-muted leading-relaxed">
          合計ポイントが同じ場合は、<strong class="text-text">1着的中数</strong>、続いて
          <strong class="text-text">2着的中数</strong>の多い方を上位とするようになりました。
          <a href="/yosouou/rules/#rank" class="text-gold hover:text-gold-soft underline underline-offset-4">ルールを見る</a>
        </p>
      </div>
      
      {totalParticipants === 0 ? (
        <div class="bg-ink-raised border border-ink-line p-12 text-center rounded-xl">
          <p class="text-text-muted text-lg mb-6">まだ参加者がいません。第1号になりませんか？</p>
          <a href={formUrl} target="_blank" rel="noopener noreferrer" class="inline-block bg-gold hover:bg-gold-soft text-ink-raised font-bold py-4 px-8 rounded-full transition-colors text-lg shadow-md w-full sm:w-auto">
            予想を応募する
          </a>
        </div>
      ) : (
        <>
          <div class="bg-ink-raised border border-ink-line rounded-xl overflow-hidden w-full">
            {/*
              3列しかないので横スクロールさせない（docs/spec.md §4.8.3）。
              ラジオネームは折り返させる。nowrap にすると
              「さきちゃん（シンプルKEIBA）」のような長い名前で表が画面幅を超え、
              モバイルで順位やポイントが見えなくなる。
            */}
            <table class="w-full text-left table-fixed">
              <thead class="bg-ink border-b border-ink-line text-xs md:text-sm text-text-faint">
                <tr>
                  <th class="px-2 md:px-4 py-3 font-normal w-12 md:w-16 text-center">順位</th>
                  <th class="px-2 md:px-4 py-3 font-normal">ラジオネーム</th>
                  <th class="px-2 md:px-4 py-3 font-normal text-right w-16 md:w-24">ポイント</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-ink-line">
                {data.participants.map((p) => (
                  <tr class="hover:bg-ink/50 transition-colors">
                    <td class="px-2 md:px-4 py-4 font-data text-center text-text-muted tabular-nums">
                      {p.rank ?? '-'}
                    </td>
                    <td class="px-2 md:px-4 py-4 text-sm md:text-base font-bold text-white break-words">
                      {p.radioName}
                    </td>
                    <td class="px-2 md:px-4 py-4 font-data text-right text-gold-soft font-bold tabular-nums">
                      {p.totalPoints ?? '-'}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="text-xs md:text-sm text-text-faint mt-4 leading-relaxed">
            ※同ポイントの場合は、1着的中数、2着的中数の順に比較して順位を決定します。
          </p>
          {hasPending && (
            <p class="text-sm text-text-muted mt-4 leading-relaxed">
              <span class="font-data text-gold-soft">-</span>
              　応募は届いていますが、締切までに有効な予想がなく、採点対象の応募が無い場合は『-』で表記しています。次のレースに締切内で応募すると、その回からポイントが入ります。
            </p>
          )}
          {beforeFirst ? (
            firstAggregationDate && (
              <p class="text-right text-sm text-text-faint mt-3">
                初回集計：{formatRaceDateJa(firstAggregationDate)}
              </p>
            )
          ) : (
            data.updatedAt && (
              <p class="text-right text-sm text-text-faint mt-3">
                最終更新：{data.updatedAt}（{data.asOfRace}）
              </p>
            )
          )}
        </>
      )}
    </section>

    <!-- 応募ボタン (下部) -->
    {totalParticipants > 0 && (
      <div class="text-center pt-8 border-t border-ink-line">
        <p class="text-text-muted mb-4">あなたのご参加をお待ちしています！</p>
        <a href={formUrl} target="_blank" rel="noopener noreferrer" class="inline-block bg-gold hover:bg-gold-soft text-ink-raised font-bold py-4 px-8 rounded-full transition-colors text-lg shadow-md w-full sm:w-auto">
          予想を応募する
        </a>
      </div>
    )}

    <!-- 番組紹介 & プラットフォームリンク -->
    <section class="border-t border-ink-line pt-12 mt-12 text-center">
      <h2 class="font-display text-xl font-bold mb-4 text-white">シンプルKEIBA を聴く</h2>
      <p class="text-text-muted mb-8 text-sm md:text-base">
        競馬にくわしくない方も楽しめる、難しくない競馬ポッドキャスト。<br/>
        毎週配信中！
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href={PLATFORM_LINKS.spotify} 
          target="_blank" 
          rel="noopener noreferrer"
          class="bg-[#1DB954] hover:bg-[#1ed760] text-black font-bold py-3 px-6 rounded-full w-full sm:w-auto flex items-center justify-center transition-colors"
        >
          Spotifyで聴く
        </a>
        <a 
          href={PLATFORM_LINKS.apple} 
          target="_blank" 
          rel="noopener noreferrer"
          class="bg-[#872EC4] hover:bg-[#9d3ee0] text-white font-bold py-3 px-6 rounded-full w-full sm:w-auto flex items-center justify-center transition-colors"
        >
          Apple Podcastsで聴く
        </a>
      </div>
    </section>

  </div>
</Layout>
