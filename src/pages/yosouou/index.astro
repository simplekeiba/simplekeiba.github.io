---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import yosououBanner from '../../assets/carousel-yosouou.png';
import races from '../../data/races.json';
import {
  fetchYosououData,
  getNextRace,
  isBeforeFirstAggregation,
  getFirstAggregationDate,
} from '../../lib/yosouou';
import { formatDateShortJa, formatDeadlineJa, formatRaceDateJa } from '../../lib/date';

const data = await fetchYosououData();
const nextRace = getNextRace();

// 集計開始前は「最終更新」を出さない（src/lib/yosouou.ts を参照）
const beforeFirst = isBeforeFirstAggregation(data);
const firstAggregationDate = getFirstAggregationDate();

const top3 = data.participants.slice(0, 3);
const totalParticipants = data.participants.length;

const formUrl = 'https://forms.gle/1r71nxcxBe35zEVE7';

const now = new Date();
const raceStatus = (race: { date: string; deadline: string }) => {
  if (nextRace && race.date === nextRace.date) return 'next';
  if (now > new Date(race.deadline)) return 'closed';
  return 'upcoming';
};

const ctaClasses =
  'inline-flex items-center justify-center gap-2 bg-gold hover:bg-gold-soft text-ink font-bold px-8 py-4 rounded-md tracking-wide transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold';

const sectionLabelClass = 'text-xs font-data font-bold text-gold-soft tracking-widest uppercase mb-4';
const sectionHeadingClass = 'text-[28px] md:text-4xl font-display font-bold text-text leading-[1.35]';

const steps = [
  { num: '01', title: '1頭を選ぶ', desc: '各GⅠで、勝つと思う馬を1頭指名。' },
  { num: '02', title: '着順でポイント', desc: null },
  { num: '03', title: '合計ポイントで勝負', desc: '全12戦終了時、最多ポイントのリスナーが優勝。' },
];
---

<Layout
  title="2026年下半期 G1予想最強リスナー決定戦 | シンプルKEIBA"
  description="秋のGⅠ12戦。各レースで1頭を指名し、着順ポイントの合計を競うリスナー参加企画です。競馬にくわしくなくても、馬券を買わなくても参加できます。"
>
  <h1 class="sr-only">2026年下半期 G1予想最強リスナー決定戦</h1>

  {data.fetchFailed && (
    <p class="max-w-[1140px] mx-auto px-4 pt-8 text-center text-sm text-red-400">
      データ取得に失敗しています。現在表示されている情報は最新ではない可能性があります。
    </p>
  )}

  <!-- 1. HERO -->
  <section class="border-b border-ink-line">
    <div class="max-w-3xl mx-auto px-4 pt-12 md:pt-16">
      <Image
        src={yosououBanner}
        alt="2026年下半期 G1予想最強リスナー決定戦"
        width={1488}
        height={830}
        class="w-full h-auto rounded-md"
      />
    </div>
    <div class="max-w-xl mx-auto px-4 py-12 md:py-16 text-center">
      <p class="text-base md:text-lg text-text-muted leading-[1.7] mb-8">
        2026年下半期G1で勝ち馬1頭を指名。<br />
        着順ポイントの合計を競うリスナー参加企画！<br />
        優勝者には豪華景品！
      </p>
      <a href={formUrl} target="_blank" rel="noopener noreferrer" class={ctaClasses}>
        予想に参加する<span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- 2. NEXT RACE -->
  <section class="border-b border-ink-line py-16 md:py-20 text-center">
    <div class="max-w-xl mx-auto px-4">
      <p class={sectionLabelClass}>NEXT RACE</p>
      {nextRace ? (
        <>
          <h2 class={`${sectionHeadingClass} mb-6`}>{nextRace.name}</h2>
          <p class="font-data text-lg text-text-muted mb-1 tabular-nums">{formatDateShortJa(nextRace.date)}</p>
          <p class="font-data text-xs text-text-faint mb-10 tabular-nums">
            応募締切　{formatDeadlineJa(nextRace.deadline)}
          </p>
          <a href={formUrl} target="_blank" rel="noopener noreferrer" class={ctaClasses}>
            このレースを予想する<span aria-hidden="true">→</span>
          </a>
        </>
      ) : (
        <p class={`${sectionHeadingClass} py-8`}>全12戦が終了しました</p>
      )}
    </div>
  </section>

  <!-- 3. HOW TO PLAY -->
  <section class="border-b border-ink-line py-16 md:py-20">
    <div class="max-w-[1140px] mx-auto px-6 md:px-4 text-center">
      <p class={sectionLabelClass}>HOW TO PLAY</p>
      <h2 class={`${sectionHeadingClass} mb-10 md:mb-16`}>参加方法はシンプル。</h2>

      <ol class="flex flex-col divide-y divide-ink-line md:flex-row md:divide-y-0 md:divide-x md:divide-ink-line max-w-3xl mx-auto text-left md:text-center">
        {steps.map((step, i) => (
          <li class={`flex items-start gap-4 py-6 first:pt-0 last:pb-0 md:flex-1 md:flex-col md:items-center md:gap-3 md:py-0 ${i > 0 ? 'md:pl-8' : ''} ${i < steps.length - 1 ? 'md:pr-8' : ''}`}>
            <span class="font-data text-xl md:text-2xl font-bold text-gold shrink-0">{step.num}</span>
            <div>
              <p class="text-base md:text-lg font-bold text-text mb-1">{step.title}</p>
              {step.desc ? (
                <p class="text-sm leading-relaxed text-text-muted">{step.desc}</p>
              ) : (
                <p class="text-sm leading-relaxed text-text-muted tabular-nums">
                  1着 <span class="text-gold font-bold">5pt</span>　2着 <span class="text-gold font-bold">3pt</span>　3着 <span class="text-gold font-bold">1pt</span>
                </p>
              )}
            </div>
          </li>
        ))}
      </ol>

      <p class="mt-10 md:mt-14 pt-6 border-t border-ink-line flex flex-wrap justify-center gap-x-6 gap-y-1 text-xs md:text-sm text-text-muted">
        <span>馬券購入不要</span>
        <span>途中参加OK</span>
        <span>締切前なら変更OK</span>
      </p>
    </div>
  </section>

  <!-- 4. CURRENT RANKING -->
  <section class="border-b border-ink-line py-16 md:py-20">
    <div class="max-w-[720px] mx-auto px-4">
      <p class={sectionLabelClass}>CURRENT RANKING</p>
      <div class="flex items-center justify-between mb-8">
        <h2 class={sectionHeadingClass}>現在のランキング</h2>
        <a href="/yosouou/ranking/" class="text-xs text-gold hover:text-gold-soft transition-colors underline underline-offset-4 shrink-0 ml-4">
          全ランキングを見る<span aria-hidden="true">→</span>
        </a>
      </div>
      {totalParticipants === 0 ? (
        <p class="text-text-faint font-data text-sm tracking-widest py-10 text-center">
          {nextRace ? `RANKING STARTS ${formatDateShortJa(nextRace.date)}` : 'RANKING'}
        </p>
      ) : (
        <div class="divide-y divide-ink-line">
          {top3.map((p) => (
            <div class="flex items-baseline justify-between py-5">
              <div class="flex items-baseline gap-4">
                <span class="font-data tabular-nums font-bold text-2xl text-gold">{p.rank}</span>
                <span class="font-bold text-lg">{p.radioName}</span>
              </div>
              <span class="font-data tabular-nums font-bold text-lg text-gold">{p.totalPoints}pt</span>
            </div>
          ))}
        </div>
      )}
      {beforeFirst ? (
        firstAggregationDate && (
          <p class="mt-6 text-right text-xs text-text-faint">
            初回集計：{formatRaceDateJa(firstAggregationDate)}
          </p>
        )
      ) : (
        data.updatedAt && (
          <p class="mt-6 text-right text-xs text-text-faint">
            最終更新：{data.updatedAt}（{data.asOfRace}）
          </p>
        )
      )}
    </div>
  </section>

  <!-- 5. RACE SCHEDULE -->
  <section class="py-16 md:py-20">
    <div class="max-w-[720px] mx-auto px-4">
      <p class={sectionLabelClass}>RACE SCHEDULE</p>
      <h2 class={`${sectionHeadingClass} mb-8`}>対象GⅠ 全12戦</h2>

      <ul>
        {races.map((race) => {
          const status = raceStatus(race);
          return (
            <li class="flex items-center gap-3 py-3 border-b border-white/10 last:border-b-0">
              <span class="font-data tabular-nums text-text-muted text-xs md:text-sm shrink-0 w-[92px] md:w-[104px]">
                {formatDateShortJa(race.date)}
              </span>
              <span class="flex-1 text-sm md:text-base text-text font-medium">{race.name}</span>
              <span class={`shrink-0 text-xs font-data tracking-wide w-10 text-right ${status === 'next' ? 'text-gold font-bold' : 'text-text-faint'}`}>
                {status === 'next' && 'NEXT'}
                {status === 'closed' && '✓'}
              </span>
            </li>
          );
        })}
      </ul>

      <p class="mt-10 text-center flex flex-col sm:flex-row justify-center items-center gap-4 sm:gap-8">
        <a href="/yosouou/rules/" class="text-sm text-gold hover:text-gold-soft transition-colors underline underline-offset-4">
          詳しいルールを見る<span aria-hidden="true">→</span>
        </a>
        <a href="/yosouou/faq/" class="text-sm text-gold hover:text-gold-soft transition-colors underline underline-offset-4">
          よくある質問を見る<span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>
</Layout>
