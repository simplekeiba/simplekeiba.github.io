---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import logo from '../assets/logo-transparent.png';

const sectionLabelClass =
  'text-xs font-data font-bold text-gold-soft tracking-widest uppercase mb-4';
const sectionHeadingClass =
  'text-[28px] md:text-4xl font-display font-bold text-text leading-[1.35]';

const stats = [
  { value: 'WEEKLY', label: '毎週更新' },
  { value: '99 EPISODES', label: '2025年 年間配信数' },
  { value: '161 MESSAGES', label: '2025年に届いたリスナーからのお便り' },
];

const history = [
  {
    date: '2024.02',
    title: 'シンプルKEIBA、配信スタート。',
    body: '第1回のテーマは「競馬って儲かるの？」競馬をこれから始める人にも分かる番組を目指し、13分のエピソードからシンプルKEIBAは始まりました。',
  },
  {
    date: '2024–2025',
    title: '予想だけではない競馬番組へ。',
    body: 'G1・重賞展望だけでなく、名馬、競馬史、馬券、馬事文化、ゲストトークなどへテーマを拡大。リスナーから届くメッセージもどんどん増え、番組とリスナーが一緒になって競馬を楽しむ現在のスタイルが形になっていきました。',
  },
  {
    date: '2025',
    title: '年間99エピソードを配信。',
    body: '1年間で届いたリスナーからのお便りは161通。「聴く番組」から、リスナーも参加する番組へ。',
  },
  {
    date: '2025.12',
    title: 'メンバーシップスタート。',
    body: '通常配信だけでは届けきれない企画や、番組制作の裏側、リスナーとの新しい交流の場づくりを開始しました。',
  },
  {
    date: '2026.05',
    title: 'PODCAST WEEKEND 2026 出店。',
    body: '音声の中だけではなく、実際にリスナーと出会える場所へ。ポッドキャストを起点に、競馬を一緒に楽しむコミュニティへと活動の幅を広げています。',
  },
];
---

<Layout
  title="シンプルKEIBAとは？ - シンプルKEIBA"
  description="競馬をまだよく知らない人も、長年見てきた人も。「シンプルKEIBA～難しくない競馬ラジオ～」がどんな番組か紹介します。"
>
  <div class="max-w-3xl mx-auto px-4 py-12 md:py-16">
    <p class="font-data text-sm font-bold text-text-faint tracking-widest mb-3">ABOUT SIMPLE KEIBA</p>
    <h1 class="text-3xl md:text-4xl font-display font-bold text-text mb-8 md:mb-10">シンプルKEIBAについて</h1>

    <Image
      src={logo}
      alt="シンプルKEIBA"
      width={520}
      height={520}
      class="block mx-auto h-auto w-[220px] max-w-[52vw] md:w-[260px] md:max-w-full mb-14"
    />

    <!-- 01｜シンプルKEIBAとは -->
    <section class="mb-20">
      <p class="text-xs font-data font-bold text-gold-soft tracking-widest uppercase mb-8">01 / ABOUT</p>
      <p class="text-2xl md:text-3xl font-display font-bold text-text leading-tight mb-6 md:mb-8 max-w-[700px]">
        競馬を、<br />
        シンプルかつ分かりやすく。
      </p>
      <div class="max-w-[700px] space-y-4">
        <p class="text-base text-text-muted leading-[1.8]">
          シンプルKEIBA～難しくない競馬ラジオ～<br />
          競馬をもっと気軽に楽しむためのポッドキャスト番組です。
        </p>
        <p class="text-base text-text-muted leading-[1.8]">
          レース予想から、名馬、競馬史、馬事文化まで。<br />
          競馬の面白さを分かりやすくお届けします。
        </p>
      </div>
    </section>

    <!-- 02｜数字で見るシンプルKEIBA -->
    <section class="mb-20">
      <p class={sectionLabelClass}>02 / NUMBERS</p>
      <h2 class={`${sectionHeadingClass} mb-8`}>数字で見るシンプルKEIBA</h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-10">
        {stats.map((stat) => (
          <div class="bg-ink-raised border border-ink-line rounded-xl p-6 text-center">
            <p class="font-data text-xl md:text-2xl font-bold text-gold-soft mb-2 tabular-nums">{stat.value}</p>
            <p class="text-sm text-text-muted">{stat.label}</p>
          </div>
        ))}
      </div>

      <blockquote class="text-center text-base md:text-lg text-text-muted leading-relaxed italic border-l-2 border-gold-soft/40 pl-6 sm:border-l-0 sm:pl-0">
        小さく始まった競馬ラジオは、<br />
        リスナーとともに少しずつその輪を広げています。
      </blockquote>
    </section>

    <!-- 03｜番組の歩み -->
    <section class="mb-20">
      <p class={sectionLabelClass}>03 / HISTORY</p>
      <h2 class={`${sectionHeadingClass} mb-10`}>番組の歩み</h2>

      <div class="space-y-10">
        {history.map((item) => (
          <div class="border-l-2 border-gold-soft/40 pl-6">
            <p class="font-data text-sm font-bold text-gold-soft tracking-wide mb-2 tabular-nums">{item.date}</p>
            <h3 class="text-lg md:text-xl font-display font-bold text-text mb-3">{item.title}</h3>
            <p class="text-base text-text-muted leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 04｜Philosophy -->
    <section>
      <p class={sectionLabelClass}>04 / PHILOSOPHY</p>
      <h2 class={`${sectionHeadingClass} mb-8`}>競馬を、もっと身近なエンタメに。</h2>
      <p class="text-base md:text-lg text-text-muted leading-relaxed mb-4">
        競馬は、詳しい人だけのものではありません。
      </p>
      <p class="text-base md:text-lg text-text-muted leading-relaxed mb-4">
        「難しそう」<br />
        「何を見ればいいか分からない」<br />
        そんな競馬への最初の壁を、少しだけ低くしたい。
      </p>
      <p class="text-base md:text-lg text-text-muted leading-relaxed mb-6">
        競馬を好きになった人たちが、笑ったり、悔しがったり、語り合える音声コミュニティ。
      </p>
      <p class="text-lg md:text-xl font-display font-bold text-gold-soft">それが、シンプルKEIBAです。</p>
    </section>
  </div>
</Layout>
