---
import { PLATFORM_LINKS, MEMBERSHIP_URL } from '../data/links';

const pathname = Astro.url.pathname;
const navItems = [
  { label: 'シンプルKEIBAとは？', href: '/about', external: false },
  { label: 'パーソナリティ紹介', href: '/personality', external: false },
  { label: 'エピソード', href: '/episodes', external: false },
  { label: 'メンバーシップ', href: MEMBERSHIP_URL, external: true }
];

const isActive = (href: string, external: boolean) => {
  if (external) return false;
  if (href === '/') {
    return pathname === href;
  }
  return pathname.startsWith(href);
};
---

<header class="fixed top-0 left-0 w-full bg-ink border-b border-ink-line z-50 flex items-center" style="height: var(--header-height);">
  <div class="flex justify-between items-center px-4 w-full mx-auto max-w-screen-xl">
    <a href="/" class="group flex flex-col justify-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold rounded-sm max-w-[180px] sm:max-w-[240px] md:max-w-none">
      <span class="font-display font-bold text-[15px] md:text-lg text-gold leading-[1.25] transition-colors group-hover:text-gold-soft">
        シンプルKEIBA
      </span>
      <span class="font-display font-semibold text-[11px] md:text-xs text-gold opacity-80 leading-[1.25] mt-[2px] transition-colors group-hover:text-gold-soft">
        ～難しくない競馬ラジオ～
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex gap-6 items-center">
      {navItems.map((item) => (
        <a
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
          class:list={[
            "text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold rounded-sm px-1 py-0.5",
            isActive(item.href, item.external) ? "text-gold" : "text-text hover:text-gold-soft"
          ]}
          aria-current={isActive(item.href, item.external) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
      <a href={PLATFORM_LINKS.spotify} target="_blank" rel="noopener noreferrer" data-cta-location="header" class="ml-2 bg-gold text-ink font-bold px-4 py-2 rounded hover:bg-gold-soft transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text">
        Spotifyで聴く
      </a>
    </nav>

    <!-- Mobile Button & Navigation -->
    <div class="flex items-center gap-3 md:hidden">
      <a href={PLATFORM_LINKS.spotify} target="_blank" rel="noopener noreferrer" data-cta-location="header-mobile" class="bg-gold text-ink text-sm font-bold px-3 py-1.5 rounded hover:bg-gold-soft transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text">
        Spotifyで聴く
      </a>
      
      <button 
        id="mobile-menu-btn" 
        class="text-text hover:text-gold-soft p-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold rounded-sm"
        aria-label="メニューを開く"
        aria-expanded="false"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hamburger-icon"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="close-icon hidden"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden absolute top-full left-0 w-full bg-ink border-b border-ink-line shadow-lg">
    <nav class="flex flex-col py-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
          class:list={[
            "block text-base font-medium py-3 px-4 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-gold focus-visible:relative z-10",
            isActive(item.href, item.external) ? "text-gold bg-ink-raised" : "text-text hover:text-gold-soft hover:bg-ink-raised transition-colors"
          ]}
          aria-current={isActive(item.href, item.external) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const setupMobileMenu = () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const hamburgerIcon = btn?.querySelector('.hamburger-icon');
    const closeIcon = btn?.querySelector('.close-icon');

    if (!btn || !menu) return;

    // Reset state in case of navigation
    btn.setAttribute('aria-expanded', 'false');
    btn.setAttribute('aria-label', 'メニューを開く');
    menu.classList.add('hidden');
    hamburgerIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');

    // Remove old event listener if exists to prevent duplicates on view transitions
    const newBtn = btn.cloneNode(true);
    btn.parentNode?.replaceChild(newBtn, btn);

    newBtn.addEventListener('click', () => {
      const isExpanded = newBtn.getAttribute('aria-expanded') === 'true';
      
      if (isExpanded) {
        newBtn.setAttribute('aria-expanded', 'false');
        newBtn.setAttribute('aria-label', 'メニューを開く');
        menu.classList.add('hidden');
        newBtn.querySelector('.hamburger-icon')?.classList.remove('hidden');
        newBtn.querySelector('.close-icon')?.classList.add('hidden');
      } else {
        newBtn.setAttribute('aria-expanded', 'true');
        newBtn.setAttribute('aria-label', 'メニューを閉じる');
        menu.classList.remove('hidden');
        newBtn.querySelector('.hamburger-icon')?.classList.add('hidden');
        newBtn.querySelector('.close-icon')?.classList.remove('hidden');
      }
    });
  };

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
